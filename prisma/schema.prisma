generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int       @id @default(autoincrement())
  name     String
  email    String    @unique
  age      Int?
  products Product[]
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  price       Int
  description String?
  
  userID Int
  user   User @relation(fields: [userID], references: [id])
}